# === API Keys ===
OPENAI_API_KEY=
JINA_API_KEY=

# === Google Play Store (no credentials needed) ===
GOOGLE_PLAY_PACKAGE_NAME=com.nextbillion.groww
GOOGLE_PLAY_COUNTRY=in
GOOGLE_PLAY_LANGUAGE=en

# === REST Server (Google Drive & Gmail via Railway FastAPI) ===
# Base URL only — no /sse suffix.
# Endpoints: POST /upload_to_drive, POST /create_email_draft
MCP_SERVER_URL=https://your-app.railway.app
# MCP_SERVER_TIMEOUT=60

# === Delivery ===
REPORT_RECIPIENTS=team@example.com

# === Pulse web UI ===
# HTTP Basic credentials. REQUIRED - protected routes return 503 until
# PULSE_PASSWORD is set, so the UI is never accidentally left open.
PULSE_USERNAME=admin
PULSE_PASSWORD=

# SQLite run history. Point at a persistent volume on Railway, otherwise
# history is lost on every deploy.
# PULSE_DB_PATH=data/pulse.db

# === Detailed PDF report ===
# Set to false to skip PDF generation and upload entirely
# PDF_ENABLED=true

# === Optional overrides ===
# Theme labelling. The default model reasons before answering, so a small
# ceiling yields empty labels and placeholder theme names.
# OPENAI_LABEL_MAX_TOKENS=512
# THEME_LABEL_MAX_WORDS=6
# REVIEW_WINDOW_WEEKS=8
# JINA_BATCH_SIZE=256
# OPENAI_MODEL=gpt-oss-120b
